local function RebuildEnemyCache()
    local now = os.clock()
    if now - EnemyCacheTime < ENEMY_CACHE_INTERVAL then return end
    EnemyCacheTime = now
    local newSet = {}
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LP and player.Character then
            local hum = player.Character:FindFirstChildOfClass("Humanoid")
            if hum and hum.Health > 0 then
                local okGame, sameGame = pcall(function() return MatchState.sameGame(player, LP) end)
                if okGame and sameGame then
                    local okTeam, sameTeam = pcall(function() return MatchState.sameTeam(player, LP) end)
                    if okTeam and sameTeam == false then
                        newSet[player] = player.Character
                    end
                end
            end
        end
    end
    EnemySet = newSet
end

