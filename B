    nameLbl.TextSize = 10
    nameLbl.TextXAlignment = Enum.TextXAlignment.Left
    nameLbl.TextTruncate = Enum.TextTruncate.AtEnd
    nameLbl.Parent = container
    local idx = math.clamp(initialIdx or 1, 1, #palette)
    local function refresh()
        local entry = palette[idx] or palette[1]
        swatch.BackgroundColor3 = entry.color or NINE_BLUE
        nameLbl.Text = entry.name
        nameLbl.TextColor3 = entry.color or NINE_TEXT
    end
    local function setIdx(newIdx, fire)
        idx = math.clamp(newIdx, 1, #palette)
        refresh()
        if fire and onChanged then onChanged(idx, palette[idx]) end
    end
    container.MouseButton1Click:Connect(function() setIdx((idx % #palette) + 1, true) end)
    refresh()
    return setIdx
end

