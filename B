RefreshGun = function()
    local gun = GetEquippedGun()
    if not gun then return false end
    if not IsCacheableWeapon(gun) then return false end

    if gun == CurrentGun and CurrentShootFunction then
        if ValidateShootFunction(CurrentShootFunction, gun) then return true end
        GunScanCache[gun.Name] = nil
        CurrentShootFunction = nil
    end

    if CurrentGunScript and CurrentGun ~= gun then EnableGunScript() end

    CurrentGun = nil
    CurrentGunScript = nil
    CurrentShootFunction = nil

    local gunScript = gun:FindFirstChildOfClass("LocalScript")
    if not gunScript then
        ScanFailTime[gun.Name] = os.clock()
        return false
    end

    local cached = GunScanCache[gun.Name]
    if cached then
        CurrentGun = gun
        CurrentGunScript = gunScript
        CurrentShootFunction = cached
        GunCooldownUpvalueFunc  = nil
        GunCooldownUpvalueIndex = nil
        if SilentAim then pcall(function() gunScript.Enabled = false end) end
        return true
    end

    if PendingGunScan == gun then return false end
    PendingGunScan = gun
    task.spawn(function()
        local shootFn = FindShootFunctionForTool(gun)
        if PendingGunScan ~= gun then return end
        PendingGunScan = nil
        if not gun:IsDescendantOf(game) then return end
        local character = LP.Character
        if not character or gun.Parent ~= character then return end
        if not shootFn then
            CurrentGun = gun
            CurrentGunScript = gunScript
            CurrentShootFunction = nil
            return
        end
        CurrentGun = gun
        CurrentGunScript = gunScript
        CurrentShootFunction = shootFn
        GunCooldownUpvalueFunc  = nil
        GunCooldownUpvalueIndex = nil
        if SilentAim then pcall(function() gunScript.Enabled = false end) end
    end)
    return false
end

