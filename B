task.spawn(function()
    local frameCount = 0
    local frameTime = 0
    RunService.RenderStepped:Connect(function(dt)
        frameCount = frameCount + 1
        frameTime = frameTime + dt
    end)
    while true do
        task.wait(1)
        local fps = 0
        if frameTime > 0 then fps = math.floor(frameCount / frameTime + 0.5) end
        frameCount = 0
        frameTime = 0
        if ShowFPS then
            fpsLabel.Text = fps .. " fps"
            if fps >= 50 then fpsLabel.TextColor3 = Color3.fromRGB(140, 220, 160)
            elseif fps >= 30 then fpsLabel.TextColor3 = Color3.fromRGB(255, 210, 100)
            else fpsLabel.TextColor3 = Color3.fromRGB(255, 110, 110) end
        else
            fpsLabel.Text = ""
        end
        local ping = nil
        pcall(function() ping = math.floor(Stats.Network.ServerStatsItem["Data Ping"]:GetValue()) end)
        if not ping or ping <= 0 then
            pcall(function() ping = math.floor(LP:GetNetworkPing() * 1000) end)
        end
        if ping and ping > 0 then
            pingLabel.Text = ping .. " ms"
            if ping < 80 then pingLabel.TextColor3 = Color3.fromRGB(140, 220, 160)
            elseif ping < 160 then pingLabel.TextColor3 = Color3.fromRGB(255, 210, 100)
            else pingLabel.TextColor3 = Color3.fromRGB(255, 110, 110) end
        end
    end
end)

