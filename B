local function ConnectCharacter(character)
    if CurrentGunScript then EnableGunScript() end
    FullCacheWipe()
    Firing = false
    InvalidateBodyPartCache(character)
    for _, child in ipairs(character:GetChildren()) do
        if child:IsA("Tool") then HookToolActivation(child) end
    end
    character.ChildAdded:Connect(function(child)
        if child:IsA("Tool") then
            HookToolActivation(child)
            if SilentAim and IsCacheableWeapon(child) then
                task.delay(0.15, RefreshGun)
                task.delay(0.5, RefreshGun)
                task.delay(1.5, RefreshGun)
                task.delay(3.0, RefreshGun)
            end
        end
    end)
    character.ChildRemoved:Connect(function(child)
        if child == CurrentGun then
            if CurrentGunScript then EnableGunScript() end
            ClearGunState()
        end
    end)
    character.DescendantAdded:Connect(function()
        InvalidateBodyPartCache(character)
    end)
    character.DescendantRemoving:Connect(function()
        InvalidateBodyPartCache(character)
    end)
    task.wait(0.3)
    RefreshESP()
    if SilentAim then
        task.spawn(function()
            for i = 1, 20 do
                if not SilentAim then return end
                if CurrentShootFunction then return end
                RefreshGun()
                task.wait(i <= 8 and 0.1 or 0.5)
            end
        end)
    end
end

