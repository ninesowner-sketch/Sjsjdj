local function HookToolActivation(tool)
    if not tool or not tool:IsA("Tool") then return end
    if tool:GetAttribute("Neegy_Hooked") then return end
    tool:SetAttribute("Neegy_Hooked", true)
    tool.Activated:Connect(function()
        if SilentAim then
            Firing = true
            task.spawn(Shoot)
            task.delay(0.1, function() Firing = false end)
        end
    end)
end

