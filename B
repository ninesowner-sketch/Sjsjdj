local function Shoot(overrideTarget, isInstant)
    if not SilentAim then return end
    if not isInstant then
        if Cooldown then
            if os.clock() - LastShootTime > 3 then Cooldown = false
            else return end
        end
    end
    local character = LP.Character
    local root = character and character:FindFirstChild("HumanoidRootPart")
    local humanoid = character and character:FindFirstChildOfClass("Humanoid")
    if not character or not root or not humanoid or humanoid.Health <= 0 then return end

    if not CurrentShootFunction or CurrentGun ~= GetEquippedGun() then
        if not RefreshGun() then
            ShootFunctionIndexReady = false
            task.spawn(function()
                for i = 1, 6 do
                    if CurrentShootFunction then return end
                    task.wait(0.25)
                    RefreshGun()
                end
            end)
            return
        end
    end

    local gun = CurrentGun
    local shootFunction = CurrentShootFunction
    if not gun or not shootFunction or not gun:IsDescendantOf(game) or gun.Parent ~= character then
        ClearGunState(); return
    end
    if IsGunInternalCooldownActive() then return end

    local target = overrideTarget or GetSilentAimTarget()
    local aimPosition
    if target and target:IsDescendantOf(workspace) then
        local th = target.Parent and target.Parent:FindFirstChildOfClass("Humanoid")
        if not th or th.Health <= 0 then return end
        aimPosition = target.Position
    else
        local cam = workspace.CurrentCamera
        if not cam then return end
        local ap = GetAimPoint()
        if not ap then return end
        local ray = cam:ViewportPointToRay(ap.X, ap.Y)
        aimPosition = ray.Origin + ray.Direction * 5000
    end

    Cooldown = true
    LastShootTime = os.clock()

    local ok = pcall(function()
        shootFunction(aimPosition, root.Position, gun)
    end)

    if not ok then
        ConsecutiveFails += 1
        GunScanCache[gun.Name] = nil
        ScanFailTime[gun.Name] = nil
        GunCooldownUpvalueFunc  = nil
        GunCooldownUpvalueIndex = nil
        ShootFunctionIndexReady = false
        if ConsecutiveFails >= 2 then
            FullCacheWipe()
            task.spawn(RefreshGun)
        else
            ClearGunState()
            Cooldown = false
        end
        return
    end
    ConsecutiveFails = 0
    task.delay(GunCooldownDuration, function() Cooldown = false end)
end

RunService.Heartbeat:Connect(function()
    if not TriggerbotEnabled then TargetAcquiredTime = 0; return end
    if not SilentAim then TargetAcquiredTime = 0; return end
    if not IsRoundActive() then TargetAcquiredTime = 0; return end

    local now = os.clock()
    if now - LastTriggerTick < 0.033 then return end
    LastTriggerTick = now

    local triggerTarget = GetTriggerTarget()
    if not triggerTarget then TargetAcquiredTime = 0; return end
    if not CurrentShootFunction or CurrentGun ~= GetEquippedGun() then
        RefreshGun()
        return
    end

    if TriggerInstant then
        LastTriggerTime = now
        TargetAcquiredTime = now
        Shoot(triggerTarget, true)
        return
    end

    if Cooldown then return end

    if TargetAcquiredTime == 0 then
        TargetAcquiredTime = now
        return
    end
    local heldFor = now - TargetAcquiredTime
    if heldFor < PreFireDelay then return end

    local effectiveDelay = TriggerDelay
    if TriggerHumanize then
        effectiveDelay = TriggerDelay + (math.random(2, 10) / 100)
    end
    if now - LastTriggerTime < effectiveDelay then return end

    LastTriggerTime = now
    Shoot(triggerTarget)
end)

local function DestroyESP(player)
    local data = ESPObjects[player]
    if not data then return end
    if data.Highlight then pcall(function() data.Highlight:Destroy() end) end
    if data.NameGui then pcall(function() data.NameGui:Destroy() end) end
    ESPObjects[player] = nil
end

local function CreateESP(player)
    DestroyESP(player)
    if player == LP then return end
    if not IsRoundActive() then return end
    if not PlayerESPEnabled and not PlayerNameESPEnabled then return end
    if not IsEnemy(player) then return end
    local character = player.Character
    if not character then return end
    local humanoid = character:FindFirstChildOfClass("Humanoid")
    if not humanoid or humanoid.Health <= 0 then return end
    local objects = {}
    if PlayerESPEnabled then
        local hl = Instance.new("Highlight")
        hl.Adornee = character
        hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
        hl.FillColor = ESPFillColor
        hl.OutlineColor = ESPFillColor
        hl.FillTransparency = 0.8
        hl.OutlineTransparency = 0
        hl.Parent = ESPGui
        objects.Highlight = hl
    end
    if PlayerNameESPEnabled then
        local head = character:FindFirstChild("Head") or character:FindFirstChild("HumanoidRootPart")
        if head then
            local ng = Instance.new("BillboardGui")
            ng.Adornee = head
            ng.AlwaysOnTop = true
            ng.Size = UDim2.fromOffset(220, 28)
            ng.StudsOffset = Vector3.new(0, 3, 0)
            ng.MaxDistance = 2000
            ng.Parent = ESPGui
            local label = Instance.new("TextLabel")
            label.BackgroundTransparency = 1
            label.Size = UDim2.fromScale(1, 1)
            label.Text = player.DisplayName
            label.TextColor3 = ESPNameColor
            label.TextStrokeColor3 = Color3.new(0, 0, 0)
            label.TextStrokeTransparency = 0.15
            label.Font = Enum.Font.GothamBold
            label.TextSize = 13
            label.Parent = ng
            objects.NameGui = ng
        end
    end
    if next(objects) ~= nil then ESPObjects[player] = objects end
end

local function RefreshESP()
    for player in pairs(ESPObjects) do
        if not player.Parent then DestroyESP(player) end
    end
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LP then CreateESP(player) end
    end
    InvalidateEnemyCache()
end

local function DisconnectPlayerConnections(player)
    local conns = PlayerConnections[player]
    if not conns then return end
    for _, c in pairs(conns) do pcall(function() c:Disconnect() end) end
    PlayerConnections[player] = nil
end

local function SetupPlayer(player)
