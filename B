local function BuildShootFunctionIndex()
    if ShootFunctionIndexReady and ShootFunctionIndex and #ShootFunctionIndex > 0 then return end
    ShootFunctionIndex = {}
    ShootFunctionIndexReady = false
    if type(getgc) ~= "function" then ShootFunctionIndexReady = true; return end
    local okGc, gc = pcall(getgc)
    if not okGc or type(gc) ~= "table" then ShootFunctionIndexReady = true; return end

    local chunkSize = 500
    if FPSMode and FPSMode >= 2 then chunkSize = 150 end

    local count = 0
    for _, fn in ipairs(gc) do
        if type(fn) == "function" then
            local okInfo, info = pcall(debug.getinfo, fn)
            if okInfo and info then
                local name = tostring(info.name or ""):lower()
                if name:find("shoot", 1, true)
                    or name:find("fire", 1, true)
                    or name:find("beam", 1, true)
                    or name:find("cast", 1, true)
                    or name:find("attack", 1, true)
                then
                    ShootFunctionIndex[#ShootFunctionIndex + 1] = fn
                end
            end
        end
        count = count + 1
        if count % chunkSize == 0 and FPSMode and FPSMode >= 2 then
            task.wait()
        end
    end
    if #ShootFunctionIndex > 0 then
        ShootFunctionIndexReady = true
    end
end

local function ValidateShootFunction(fn, tool)
    if not fn or not tool then return false end
    if not tool:IsDescendantOf(game) then return false end
    local okUps, ups = pcall(getupvalues, fn)
    if not okUps or type(ups) ~= "table" then return true end
    for _, v in pairs(ups) do
        if typeof(v) == "Instance" then
            if v:IsA("RemoteEvent") or v:IsA("RemoteFunction") then
                if not v:IsDescendantOf(game) then return false end
            end
        end
    end
    return true
end

local RefreshGun

local function FindShootFunctionForTool(tool)
    if not tool then return nil end
    local cacheKey = tool.Name
    local cached = GunScanCache[cacheKey]
    if cached ~= nil then return cached end

    ShootFunctionIndexReady = false
    BuildShootFunctionIndex()
    if not ShootFunctionIndex or #ShootFunctionIndex == 0 then
        ScanFailTime[cacheKey] = os.clock()
        return nil
    end

    local toolRemotes = {}
    for _, obj in ipairs(tool:GetDescendants()) do
        if obj:IsA("RemoteEvent") or obj:IsA("RemoteFunction") then
            toolRemotes[obj] = true
        end
    end
    local handle = tool:FindFirstChild("Handle")
    local toolSet = { [tool] = true }
    for _, obj in ipairs(tool:GetDescendants()) do toolSet[obj] = true end

    local bestFn = nil

    do
        local MAX_SCORE = 15
        local bestScore = -1
        for _, fn in ipairs(ShootFunctionIndex) do
            local okUps, ups = pcall(getupvalues, fn)
            if okUps and type(ups) == "table" then
                local remoteCount = 0
                local hasHandle = false
                for _, v in pairs(ups) do
                    if toolRemotes[v] then remoteCount += 1 end
                    if v == handle then hasHandle = true end
                end
                if remoteCount >= 1 then
                    local score = remoteCount + (hasHandle and 1 or 0)
                    if score <= MAX_SCORE and score > bestScore then
                        bestScore = score
                        bestFn = fn
                    end
                end
            end
        end
    end

    if not bestFn then
        local gunScript = tool:FindFirstChildOfClass("LocalScript")
        if gunScript then
            local targetSource = "@" .. gunScript:GetFullName()
            for _, fn in ipairs(ShootFunctionIndex) do
                local okInfo, info = pcall(debug.getinfo, fn, "s")
                if okInfo and info and tostring(info.source or "") == targetSource then
                    local okUps, ups = pcall(getupvalues, fn)
                    if okUps and type(ups) == "table" then
                        for _, v in pairs(ups) do
                            if v == handle then
                                bestFn = fn
                                break
                            end
                        end
                    end
                end
                if bestFn then break end
            end
        end
    end

    if not bestFn then
        local gunScript = tool:FindFirstChildOfClass("LocalScript")
        if gunScript then
            local targetSource = "@" .. gunScript:GetFullName()
            for _, fn in ipairs(ShootFunctionIndex) do
                local okInfo, info = pcall(debug.getinfo, fn, "s")
                if okInfo and info and tostring(info.source or "") == targetSource then
                    local okUps, ups = pcall(getupvalues, fn)
                    if okUps and type(ups) == "table" then
                        for _, v in pairs(ups) do
                            if toolSet[v] then
                                bestFn = fn
                                break
                            end
                        end
                    end
                end
                if bestFn then break end
            end
        end
    end

    if not bestFn then
        local gunScript = tool:FindFirstChildOfClass("LocalScript")
        if gunScript then
            local gunFullName = gunScript:GetFullName()
            for _, fn in ipairs(ShootFunctionIndex) do
                local okInfo, info = pcall(debug.getinfo, fn, "s")
                if okInfo and info then
                    local src = tostring(info.source or "")
                    if src:find(gunFullName, 1, true) then
                        bestFn = fn
                        break
                    end
                end
            end
        end
    end

    if not bestFn and (not FPSMode or FPSMode < 2) then
        local okGc, gc = pcall(getgc)
        if okGc and type(gc) == "table" then
            for _, fn in ipairs(gc) do
                if type(fn) == "function" then
                    local okUps, ups = pcall(getupvalues, fn)
                    if okUps and type(ups) == "table" then
                        for _, v in pairs(ups) do
                            if toolRemotes[v] then
                                bestFn = fn
                                break
                            end
                        end
                        if bestFn then break end
                    end
                end
            end
        end
    end

    if bestFn then
        GunScanCache[cacheKey] = bestFn
        ScanFailTime[cacheKey] = nil
        ConsecutiveScanFails = 0
        AutoReequipAttempts = 0
        if SilentAim and not CacheReadyToasted then CacheReadyToasted = true end
    else
        GunScanCache[cacheKey] = nil
        ScanFailTime[cacheKey] = os.clock()
        ConsecutiveScanFails += 1
    end
    return bestFn
end

