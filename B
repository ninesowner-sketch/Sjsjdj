local function setActiveTab(tabName)
    for name, data in pairs(tabButtons) do
        local isActive = (name == tabName)
        data.Label.TextColor3 = isActive and NINE_TEXT or Color3.fromRGB(140, 140, 150)
        data.Underline.Visible = isActive
        data.Background.BackgroundColor3 = isActive and NINE_BTN or NINE_FIELD
        data.Background.BackgroundTransparency = isActive and 0 or 0.4
    end
    for name, page in pairs(tabPages) do
        page.Visible = (name == tabName)
    end
    if pageContainer then pageContainer.CanvasPosition = Vector2.new(0, 0) end
end

