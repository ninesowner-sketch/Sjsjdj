local function LoadAllConfigs()
    if not isfile(CONFIG_KEY .. ".json") then return {} end
    local ok, data = pcall(function() return HttpService:JSONDecode(readfile(CONFIG_KEY .. ".json")) end)
    return (ok and typeof(data) == "table") and data or {}
end
local function SaveAllConfigs(configs)
    pcall(function() writefile(CONFIG_KEY .. ".json", HttpService:JSONEncode(configs)) end)
end
local function LoadAutoLoadState()
    if not isfile(AUTOLOAD_STATE_KEY) then return false end
    local ok, data = pcall(function() return HttpService:JSONDecode(readfile(AUTOLOAD_STATE_KEY)) end)
    return ok and typeof(data) == "table" and data.enabled == true
end
local function SaveAutoLoadState(state)
    pcall(function() writefile(AUTOLOAD_STATE_KEY, HttpService:JSONEncode({ enabled = state == true })) end)
end
local function LoadLastConfigName()
    if not isfile(LAST_CONFIG_KEY) then return "" end
    local ok, data = pcall(function() return HttpService:JSONDecode(readfile(LAST_CONFIG_KEY)) end)
    return (ok and data and data.last) or ""
end
local function SaveLastConfigName(name)
    pcall(function() writefile(LAST_CONFIG_KEY, HttpService:JSONEncode({ last = name })) end)
end

