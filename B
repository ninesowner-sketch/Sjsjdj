local function FPS_SaveState()
    if FPSState then return end
    local s = {
        RemovedLightingChildren = {},
        DisabledParticles = {},
        DisabledLights = {},
        DisabledBeams = {},
        OriginalLighting = {
            GlobalShadows = Lighting.GlobalShadows,
            ShadowSoftness = Lighting.ShadowSoftness,
            FogEnd = Lighting.FogEnd,
            FogStart = Lighting.FogStart,
            Brightness = Lighting.Brightness,
            Ambient = Lighting.Ambient,
            OutdoorAmbient = Lighting.OutdoorAmbient,
            EnvironmentDiffuseScale = Lighting.EnvironmentDiffuseScale,
            EnvironmentSpecularScale = Lighting.EnvironmentSpecularScale,
            ClockTime = Lighting.ClockTime,
            GeographicLatitude = Lighting.GeographicLatitude,
        },
        CastShadowParts = {},
        AnchoredParts = {},
        HiddenGuis = {},
        OriginalQuality = nil,
        OriginalQualitySetting = nil,
        OriginalMeshDetail = nil,
    }
    FPSState = s

    pcall(function()
        local UGS = UserSettings:GetService("UserGameSettings")
        s.OriginalQuality = UGS.SavedQualityLevel
        UGS.SavedQualityLevel = Enum.SavedQualitySetting.QualityLevel1
    end)
    pcall(function()
        if settings and settings().Rendering then
            s.OriginalQualitySetting = settings().Rendering.QualityLevel
            settings().Rendering.QualityLevel = Enum.QualityLevel.Level01
        end
    end)
    pcall(function()
        if settings and settings().Rendering then
            s.OriginalMeshDetail = settings().Rendering.MeshPartDetail
            settings().Rendering.MeshPartDetail = Enum.MeshDetailLevel.Low
        end
    end)
end

local function FPS_RestoreState()
    if not FPSState then return end
    local L = FPSState.OriginalLighting
    if L then
        pcall(function()
            Lighting.GlobalShadows = L.GlobalShadows
            Lighting.ShadowSoftness = L.ShadowSoftness
            Lighting.FogEnd = L.FogEnd
            Lighting.FogStart = L.FogStart
            Lighting.Brightness = L.Brightness
            Lighting.Ambient = L.Ambient
            Lighting.OutdoorAmbient = L.OutdoorAmbient
            Lighting.EnvironmentDiffuseScale = L.EnvironmentDiffuseScale
            Lighting.EnvironmentSpecularScale = L.EnvironmentSpecularScale
            Lighting.ClockTime = L.ClockTime
            Lighting.GeographicLatitude = L.GeographicLatitude
        end)
    end
    for _, e in ipairs(FPSState.RemovedLightingChildren) do
        pcall(function() e.instance.Parent = e.parent end)
    end
    for _, e in ipairs(FPSState.DisabledParticles) do
        pcall(function() e.instance.Enabled = e.was end)
    end
    for _, e in ipairs(FPSState.DisabledLights) do
        pcall(function() e.instance.Enabled = e.was end)
    end
    for _, e in ipairs(FPSState.DisabledBeams) do
        pcall(function() e.instance.Enabled = e.was end)
    end
    for _, e in ipairs(FPSState.CastShadowParts) do
        pcall(function() e.instance.CastShadow = e.was end)
    end
    for _, e in ipairs(FPSState.AnchoredParts) do
        pcall(function() e.instance.Anchored = e.was end)
    end
    for _, e in ipairs(FPSState.HiddenGuis) do
        pcall(function() e.instance.Enabled = e.was end)
    end
    pcall(function()
        local UGS = UserSettings:GetService("UserGameSettings")
        if FPSState.OriginalQuality then
            UGS.SavedQualityLevel = FPSState.OriginalQuality
        end
    end)
    pcall(function()
        if settings and settings().Rendering and FPSState.OriginalQualitySetting then
            settings().Rendering.QualityLevel = FPSState.OriginalQualitySetting
        end
    end)
    pcall(function()
        if settings and settings().Rendering and FPSState.OriginalMeshDetail then
            settings().Rendering.MeshPartDetail = FPSState.OriginalMeshDetail
        end
    end)
    FPSState = nil
end

local function FPS_ProcessInstance(v)
    if not FPSState then return end

    if v:IsA("ParticleEmitter") or v:IsA("Trail") or v:IsA("Smoke") or v:IsA("Fire") or v:IsA("Sparkles") then
        if v.Enabled then
            table.insert(FPSState.DisabledParticles, { instance = v, was = true })
            v.Enabled = false
        end
        return
    end

    if v:IsA("Beam") then
        if v.Enabled then
            table.insert(FPSState.DisabledBeams, { instance = v, was = true })
            v.Enabled = false
        end
        return
    end

    if v:IsA("PointLight") or v:IsA("SpotLight") or v:IsA("SurfaceLight") then
        if v.Enabled then
            table.insert(FPSState.DisabledLights, { instance = v, was = true })
            v.Enabled = false
        end
        return
    end

    if FPSMode >= 3 then
        if v:IsA("BasePart") then
            if v.CastShadow then
                table.insert(FPSState.CastShadowParts, { instance = v, was = true })
                pcall(function() v.CastShadow = false end)
            end
            pcall(function()
                if v.Material ~= Enum.Material.SmoothPlastic then
                    v.Material = Enum.Material.SmoothPlastic
                end
            end)
            return
        end
        if v:IsA("Decal") or v:IsA("Texture") then
            pcall(function()
                v.Transparency = 1
            end)
            return
        end
        if v:IsA("MeshPart") then
            pcall(function() v.RenderFidelity = Enum.RenderFidelity.Performance end)
            return
        end
    end
end

local function FPS_ScanWorkspace()
    if not FPSState then return end
    local ok, desc = pcall(function() return workspace:GetDescendants() end)
    if not ok or not desc then return end
    for _, v in ipairs(desc) do
        FPS_ProcessInstance(v)
    end
end

local function FPS_HidePlayerGuis()
    if not FPSState or FPSMode < 3 then return end
    for _, gui in ipairs(PlayerGui:GetChildren()) do
        if gui:IsA("ScreenGui") and gui.Name ~= "NINE_Hub" and gui.Name ~= "NeegyHUB_MVS_ESP" then
            if gui.Enabled then
                table.insert(FPSState.HiddenGuis, { instance = gui, was = true })
                pcall(function() gui.Enabled = false end)
            end
        end
    end
end

local function FPS_ReducePhysics()
    if not FPSState or FPSMode < 3 then return end
    local ok, desc = pcall(function() return workspace:GetDescendants() end)
    if not ok or not desc then return end
    for _, v in ipairs(desc) do
        if v:IsA("BasePart") and not v.Anchored then
            local isCharacterPart = false
            local ancestor = v.Parent
            local depth = 0
            while ancestor and depth < 5 do
                if ancestor:IsA("Model") and ancestor:FindFirstChildOfClass("Humanoid") then
                    isCharacterPart = true
                    break
                end
                ancestor = ancestor.Parent
                depth = depth + 1
            end
            if not isCharacterPart then
                local size = v.Size
                if size.X < 4 and size.Y < 4 and size.Z < 4 then
                    table.insert(FPSState.AnchoredParts, { instance = v, was = false })
                    pcall(function() v.Anchored = true end)
                end
            end
        end
    end
end

local function FPS_ApplyLighting()
    pcall(function()
        Lighting.GlobalShadows = false
        Lighting.ShadowSoftness = 0
        Lighting.FogEnd = 1000000
        Lighting.FogStart = 0
        Lighting.Brightness = 2
        Lighting.EnvironmentDiffuseScale = 0
        Lighting.EnvironmentSpecularScale = 0
        Lighting.Ambient = Color3.fromRGB(180, 180, 180)
        Lighting.OutdoorAmbient = Color3.fromRGB(180, 180, 180)
        if FPSMode >= 3 then
            Lighting.ClockTime = 14
            Lighting.GeographicLatitude = 0
        end
    end)

    for _, v in ipairs(Lighting:GetChildren()) do
        if v:IsA("PostEffect") or v:IsA("Atmosphere")
            or v:IsA("BloomEffect") or v:IsA("BlurEffect")
            or v:IsA("SunRaysEffect") or v:IsA("ColorCorrectionEffect")
            or v:IsA("DepthOfFieldEffect") then
            if FPSState then
                table.insert(FPSState.RemovedLightingChildren, { instance = v, parent = v.Parent })
            end
            v.Parent = nil
        end
    end

    if FPSMode >= 3 then
        for _, v in ipairs(Lighting:GetChildren()) do
            if v:IsA("Sky") then
                if FPSState then
                    table.insert(FPSState.RemovedLightingChildren, { instance = v, parent = v.Parent })
                end
                v.Parent = nil
            end
        end
        pcall(function()
            local terrain = workspace:FindFirstChildOfClass("Terrain")
            if terrain then
                terrain.WaterWaveSize = 0
                terrain.WaterWaveSpeed = 0
                terrain.WaterReflectance = 0
                terrain.WaterTransparency = 1
            end
        end)
    end
end

local function FPS_ApplyAll()
    FPS_SaveState()
    FPS_ApplyLighting()

    if FPSMode >= 3 then
        FPS_HidePlayerGuis()
    end

    task.spawn(FPS_ScanWorkspace)

    if FPSMode >= 3 then
        task.spawn(FPS_ReducePhysics)
    end

    if not FPSAddedConn then
        FPSAddedConn = workspace.DescendantAdded:Connect(function(v)
            if FPSMode == 0 or not FPSState then return end
            task.defer(function()
                if FPSMode == 0 or not FPSState then return end
                FPS_ProcessInstance(v)
            end)
        end)
    end

    if #FPSConnections == 0 then
        local c = RunService.Heartbeat:Connect(function()
            if FPSMode == 0 then return end
            local now = os.clock()
            if now - FPSIterationTick < 5 then return end
            FPSIterationTick = now
            if FPSMode >= 2 then
                task.spawn(FPS_ScanWorkspace)
            end
        end)
        table.insert(FPSConnections, c)
    end
end

local function FPS_SetMode(mode)
    if mode == FPSMode then return end
    local wasOn = FPSMode > 0
    local willBeOn = mode > 0

    if wasOn then
        FPS_DisconnectAll()
        FPS_RestoreState()
    end

    FPSMode = mode

    if willBeOn then
        FPS_ApplyAll()
    end
end

local function ApplyState(state)
    if typeof(state) ~= "table" then return end
    if typeof(state.SilentAim) == "boolean" and UIRefs.SilentAim then UIRefs.SilentAim(state.SilentAim, true) end
    if typeof(state.VisibleCheck) == "boolean" and UIRefs.VisibleCheck then UIRefs.VisibleCheck(state.VisibleCheck, true) end
    if typeof(state.LeadPrediction) == "boolean" and UIRefs.LeadPrediction then UIRefs.LeadPrediction(state.LeadPrediction, true) end
    if typeof(state.TriggerbotEnabled) == "boolean" and UIRefs.Triggerbot then UIRefs.Triggerbot(state.TriggerbotEnabled, true) end
    if typeof(state.TriggerInstant) == "boolean" and UIRefs.TriggerInstant then UIRefs.TriggerInstant(state.TriggerInstant, true) end
    if typeof(state.TriggerHumanize) == "boolean" and UIRefs.TriggerHumanize then UIRefs.TriggerHumanize(state.TriggerHumanize, true) end
    if typeof(state.PlayerESP) == "boolean" and UIRefs.PlayerESP then UIRefs.PlayerESP(state.PlayerESP, true) end
    if typeof(state.PlayerNameESP) == "boolean" and UIRefs.PlayerNameESP then UIRefs.PlayerNameESP(state.PlayerNameESP, true) end
    if typeof(state.CustomTrace) == "boolean" and UIRefs.CustomTrace then UIRefs.CustomTrace(state.CustomTrace, true) end
    if typeof(state.FPSBoost) == "boolean" and UIRefs.FPSBoost then UIRefs.FPSBoost(state.FPSBoost, true) end
    if typeof(state.FPSBoostAggressive) == "boolean" and UIRefs.FPSAggressive then UIRefs.FPSAggressive(state.FPSBoostAggressive, true) end
    if typeof(state.FPSBoostExtreme) == "boolean" and UIRefs.FPSExtreme then UIRefs.FPSExtreme(state.FPSBoostExtreme, true) end

    if typeof(state.TargetPart) == "string" and UIRefs.TargetPart then
        for i, entry in ipairs(TargetPartsPalette) do
            if entry.name == state.TargetPart then UIRefs.TargetPart(i, true); break end
        end
    end
    if typeof(state.DistancePriority) == "string" and UIRefs.DistancePriority then
        for i, entry in ipairs(DistancePalette) do
            if entry.name == state.DistancePriority then UIRefs.DistancePriority(i, true); break end
        end
    end

    local function FindPaletteIdx(r, g, b)
        if typeof(r) ~= "number" or typeof(g) ~= "number" or typeof(b) ~= "number" then return nil end
        local c = Color3.new(r, g, b)
        for i, entry in ipairs(ColorPalette) do
            local diff = math.abs(entry.color.R - c.R) + math.abs(entry.color.G - c.G) + math.abs(entry.color.B - c.B)
            if diff < 0.15 then return i end
        end
        return nil
    end
    if UIRefs.ESPColor then
        local idx = FindPaletteIdx(state.ESPColorR, state.ESPColorG, state.ESPColorB)
        if idx then UIRefs.ESPColor(idx, true) end
    end
    if UIRefs.NameColor then
        local idx = FindPaletteIdx(state.NameColorR, state.NameColorG, state.NameColorB)
        if idx then UIRefs.NameColor(idx, true) end
    end
    if UIRefs.TraceColor then
        local idx = FindPaletteIdx(state.TraceColorR, state.TraceColorG, state.TraceColorB)
        if idx then UIRefs.TraceColor(idx, true) end
    end

    if typeof(state.AimOffsetX) == "number" and UIRefs.AimOffsetX then UIRefs.AimOffsetX(state.AimOffsetX, true) end
    if typeof(state.AimOffsetY) == "number" and UIRefs.AimOffsetY then UIRefs.AimOffsetY(state.AimOffsetY, true) end
    if typeof(state.LeadPredictionStrength) == "number" and UIRefs.LeadStrength then
        UIRefs.LeadStrength(math.floor(state.LeadPredictionStrength * 100 + 0.5), true)
    end
    if typeof(state.TriggerFOV) == "number" and UIRefs.TriggerFOV then UIRefs.TriggerFOV(state.TriggerFOV, true) end
    if typeof(state.PreFireDelay) == "number" and UIRefs.PreFireDelay then
        UIRefs.PreFireDelay(math.floor(state.PreFireDelay * 100 + 0.5), true)
    end
    if typeof(state.TriggerDelay) == "number" and UIRefs.TriggerDelay then
        UIRefs.TriggerDelay(math.floor(state.TriggerDelay * 100 + 0.5), true)
    end
end

