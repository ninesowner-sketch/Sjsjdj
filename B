local function IsCacheableWeapon(tool)
    if not tool or not tool:IsA("Tool") then return false end
    if not tool:FindFirstChild("Handle") then return false end
    if not tool:FindFirstChildOfClass("LocalScript") then return false end
    local n = tool.Name:lower()
    if n:find("knife", 1, true) or n:find("sword", 1, true) or n:find("blade", 1, true)
        or n:find("machete", 1, true) or n:find("axe", 1, true) or n:find("hammer", 1, true)
        or n:find("bat", 1, true) or n:find("melee", 1, true) then
        return false
    end
    return true
end

