end

local function GetSilentAimTarget()
    if not SilentAim then return nil end
    if not IsRoundActive() then return nil end
    RebuildEnemyCache()
    local cam = workspace.CurrentCamera
    local aimPoint = GetAimPoint()
    if not cam or not aimPoint then return nil end

    local bestPart = nil
    local bestDistance = DistancePriority == "Closest" and math.huge or -math.huge
    local adjustedAim = Vector2.new(aimPoint.X + AimOffsetX, aimPoint.Y + AimOffsetY)

    for _, character in pairs(EnemySet) do
        if character then
            if TargetPart == "Nearest Part" then
                for _, part in ipairs(GetBodyParts(character)) do
                    local pp = GetPredictedPosition(part)
                    local screen, visible = cam:WorldToViewportPoint(pp)
                    if visible and screen.Z > 0 then
                        local dx = screen.X - adjustedAim.X
                        local dy = screen.Y - adjustedAim.Y
                        local sd = math.sqrt(dx * dx + dy * dy)
                        local wd = (pp - cam.CFrame.Position).Magnitude
                        local better = DistancePriority == "Closest" and sd < bestDistance or wd > bestDistance
                        if better and IsVisible(part) then
                            bestDistance = DistancePriority == "Closest" and sd or wd
                            bestPart = part
                        end
                    end
                end
            else
                local part = GetFixedTargetPart(character)
                if part then
                    local pp = GetPredictedPosition(part)
                    local screen, visible = cam:WorldToViewportPoint(pp)
                    if visible and screen.Z > 0 then
                        local dx = screen.X - adjustedAim.X
                        local dy = screen.Y - adjustedAim.Y
                        local sd = math.sqrt(dx * dx + dy * dy)
                        local wd = (pp - cam.CFrame.Position).Magnitude
                        local better = DistancePriority == "Closest" and sd < bestDistance or wd > bestDistance
                        if better and IsVisible(part) then
                            bestDistance = DistancePriority == "Closest" and sd or wd
                            bestPart = part
                        end
                    end
                end
            end
        end
    end
    return bestPart
end

