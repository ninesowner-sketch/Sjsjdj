local function createStepperRow(parent, labelText, layoutOrder, minVal, maxVal, initialVal, stepVal, onChanged, fmt)
    local bg = Instance.new("Frame")
    bg.Size = UDim2.new(1, 0, 0, 24)
    bg.BackgroundColor3 = NINE_BTN
    bg.LayoutOrder = layoutOrder
    bg.Parent = parent
    Instance.new("UICorner", bg).CornerRadius = UDim.new(0, 5)
    local s = Instance.new("UIStroke", bg); s.Color = NINE_BORDER; s.Thickness = 1
