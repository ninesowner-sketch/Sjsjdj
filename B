task.spawn(function()
    while true do
        if not SilentAim then
            task.wait(1.0)
            continue
        end
        local gun = GetEquippedGun()
        if not gun or not IsCacheableWeapon(gun) then
            task.wait(1.0)
            continue
        end
        if CurrentShootFunction then
            task.wait(1.0)
            local currentScript = gun:FindFirstChildOfClass("LocalScript")
            if currentScript and currentScript ~= CurrentGunScript then
                GunScanCache[gun.Name] = nil
                ScanFailTime[gun.Name] = nil
                ShootFunctionIndexReady = false
                ClearGunState()
                RefreshGun()
            end
        else
            GunScanCache[gun.Name] = nil
            ScanFailTime[gun.Name] = nil
            RefreshGun()
            local delay = 0.35
            if FPSMode >= 2 then delay = 1.5 end
            if AutoReequipAttempts > 0 then delay = 0.75 end
            task.wait(delay)
        end
    end
end)

task.spawn(function()
    while true do
        task.wait(1.0)
        if not SilentAim then
            AutoReequipAttempts = 0
            continue
        end
        if CurrentShootFunction then
            AutoReequipAttempts = 0
            continue
        end
        local gun = GetEquippedGun()
        if not gun or not IsCacheableWeapon(gun) then
            continue
        end
        local now = os.clock()
        if now - AutoReequipLastTime < CACHE_AUTO_REQUIP_COOLDOWN then
            continue
        end
        if AutoReequipAttempts == 0 then
            AutoReequipAttempts = 1
            AutoReequipLastTime = now
            task.delay(CACHE_AUTO_REQUIP_DELAY, function()
                if not SilentAim then return end
                if CurrentShootFunction then return end
                local character = LP.Character
                if not character then return end
                local currentGun = GetEquippedGun()
                if not currentGun or not IsCacheableWeapon(currentGun) then return end
                local humanoid = character:FindFirstChildOfClass("Humanoid")
                if not humanoid then return end
                pcall(function() humanoid:UnequipTools() end)
                task.wait(0.15)
                pcall(function() humanoid:EquipTool(currentGun) end)
                AutoReequipLastTime = os.clock()
            end)
        end
    end
end)

task.spawn(function()
    while true do
        task.wait(5.0)
        if not SilentAim then continue end
        local bp = LP:FindFirstChild("Backpack")
        if not bp then continue end
        for _, child in ipairs(bp:GetChildren()) do
            if IsCacheableWeapon(child) then
                local cached = GunScanCache[child.Name]
                if cached == nil then
                    task.spawn(function() FindShootFunctionForTool(child) end)
                end
            end
        end
    end
end)

task.spawn(function()
    local previousState = false
    while task.wait(0.5) do
        local currentState = IsRoundActive()
        if currentState ~= previousState then
            previousState = currentState
            FullCacheWipe()
            RefreshESP()
            InvalidateEnemyCache()
            InvalidateBodyPartCache()
            if SilentAim then
                task.spawn(function()
                    for i = 1, 15 do
                        if not SilentAim then return end
                        if CurrentShootFunction then return end
                        RefreshGun()
                        task.wait(0.4)
                    end
                end)
            end
        end
        if not currentState and next(ESPObjects) ~= nil then
            for player in pairs(ESPObjects) do DestroyESP(player) end
        end
    end
end)

