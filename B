    lbl.TextTruncate = Enum.TextTruncate.AtEnd
    lbl.Parent = bg
    local btnMinus = Instance.new("TextButton")
    btnMinus.Size = UDim2.new(0, 20, 0, 20)
    btnMinus.Position = UDim2.new(1, -92, 0.5, -10)
    btnMinus.BackgroundColor3 = NINE_FIELD
    btnMinus.Font = Enum.Font.GothamBold
    btnMinus.Text = "-"
    btnMinus.TextColor3 = NINE_TEXT
    btnMinus.TextSize = 12
    btnMinus.Parent = bg
    Instance.new("UICorner", btnMinus).CornerRadius = UDim.new(0, 4)
    local valueLbl = Instance.new("TextLabel")
    valueLbl.Size = UDim2.new(0, 40, 1, 0)
    valueLbl.Position = UDim2.new(1, -70, 0, 0)
    valueLbl.BackgroundTransparency = 1
    valueLbl.Font = Enum.Font.GothamBold
    valueLbl.Text = fmt and fmt(initialVal) or tostring(initialVal)
    valueLbl.TextColor3 = NINE_BLUE
    valueLbl.TextSize = 11
    valueLbl.Parent = bg
    local btnPlus = Instance.new("TextButton")
    btnPlus.Size = UDim2.new(0, 20, 0, 20)
    btnPlus.Position = UDim2.new(1, -30, 0.5, -10)
    btnPlus.BackgroundColor3 = NINE_FIELD
    btnPlus.Font = Enum.Font.GothamBold
    btnPlus.Text = "+"
    btnPlus.TextColor3 = NINE_TEXT
    btnPlus.TextSize = 12
    btnPlus.Parent = bg
    Instance.new("UICorner", btnPlus).CornerRadius = UDim.new(0, 4)
    local currentVal = initialVal
    local function update(newVal, fire)
        currentVal = math.clamp(newVal, minVal, maxVal)
        if stepVal < 0.1 then currentVal = math.floor(currentVal * 1000 + 0.5) / 1000
        elseif stepVal < 1 then currentVal = math.floor(currentVal * 100 + 0.5) / 100
        else currentVal = math.floor(currentVal + 0.5) end
        valueLbl.Text = fmt and fmt(currentVal) or tostring(currentVal)
        if fire and onChanged then onChanged(currentVal) end
    end
    btnMinus.MouseButton1Click:Connect(function() update(currentVal - stepVal, true) end)
    btnPlus.MouseButton1Click:Connect(function() update(currentVal + stepVal, true) end)
    return update
end

